    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:color="#2EC4B6" android:offset="0.0" />
                <item android:color="#3A86FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
